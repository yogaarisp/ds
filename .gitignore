# Common folders to ignore
node_modules/
frontend/node_modules/
backend/vendor/

# Environment files
.env
backend/.env
frontend/.env
*.env.local

# Build outputs
dist/
frontend/dist/

# OS files
.DS_Store
Thumbs.db

# Laravel specific
backend/storage/*.log
backend/storage/framework/sessions/*
backend/storage/framework/views/*.php
backend/storage/framework/cache/data/*

# App specific
*.zip
*.tar.gz

# Android build files
android-webview/.gradle/
android-webview/build/
android-webview/app/build/
*.apk
*.aab

# Keystore files (security)
*.keystore
*.jks

# Laravel logs
backend/storage/logs/*.log
