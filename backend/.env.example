APP_NAME="Dimsum Sarang POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dimsum_pos
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# MAIL CONFIGURATION (SMTP)
# ============================================
# NOTE: Email settings dikelola dari Admin Dashboard
# Login sebagai Owner → Pengaturan → Tab Email
# Tidak perlu isi di sini, kecuali untuk fallback
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost
