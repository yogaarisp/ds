<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Background putih solid -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white"/>
        </shape>
    </item>
    
    <!-- Logo di tengah dengan ukuran responsive -->
    <item android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_small"
            android:width="52dp"
            android:height="52dp"
            android:antialias="true"
            android:filter="true"/>
    </item>
    
    <!-- Loading bar di bawah logo -->
    <item android:gravity="center_horizontal|center_vertical"
          android:top="90dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimary"/>
            <size android:width="48dp" android:height="4dp"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    
    <!-- Loading dots untuk visual feedback -->
    <item android:gravity="center_horizontal|center_vertical"
          android:top="110dp">
        <shape android:shape="oval">
            <solid android:color="@color/colorPrimary"/>
            <size android:width="6dp" android:height="6dp"/>
        </shape>
    </item>
    
    <!-- Second dot -->
    <item android:gravity="center_horizontal|center_vertical"
          android:top="110dp"
          android:left="12dp">
        <shape android:shape="oval">
            <solid android:color="@color/colorPrimary"/>
            <size android:width="6dp" android:height="6dp"/>
        </shape>
    </item>
    
    <!-- Third dot -->
    <item android:gravity="center_horizontal|center_vertical"
          android:top="110dp"
          android:left="24dp">
        <shape android:shape="oval">
            <solid android:color="@color/colorPrimary"/>
            <size android:width="6dp" android:height="6dp"/>
        </shape>
    </item>
    
</layer-list>